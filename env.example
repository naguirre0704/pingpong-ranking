# Reference template. Copy to .env and fill in (the .env file is gitignored).

# Supabase Postgres connection (direct connection, port 5432).
# Supabase -> Project Settings -> Database -> Connection string -> URI
DATABASE_URL=postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres?sslmode=require

# Shared PIN required for any write action. Viewing the ranking is public.
APP_PIN=2468
